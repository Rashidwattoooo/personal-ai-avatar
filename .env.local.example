# Your Tavus API key from https://platform.tavus.io/api-keys
TAVUS_API_KEY=your_tavus_api_key_here

# The Persona / PAL ID defining prompt, tone, voice, and conversational dynamics
# Created or selected at https://platform.tavus.io/personas
TAVUS_PERSONA_ID=your_tavus_persona_id_here

# The Replica ID representing the visual appearance of the digital human
# Stock replicas available or custom replica from https://platform.tavus.io/replicas
TAVUS_REPLICA_ID=your_tavus_replica_id_here

# Optional: Knowledge Base Document IDs for RAG (comma-separated if multiple)
# Upload documents at https://platform.tavus.io/knowledge-base
TAVUS_DOCUMENT_IDS=

# Optional: Document retrieval strategy ('balanced', 'speed', or 'quality')
TAVUS_DOCUMENT_RETRIEVAL_STRATEGY=balanced

# Optional: Custom initial greeting spoken by the avatar upon joining
TAVUS_CUSTOM_GREETING=Hello! I am your personal AI avatar assistant. How can I help you today?
